# Public identity of this MCP server. Must equal the URL OAuth clients hit;
# the discovery metadata endpoints emit it verbatim. After deploying to Cloud
# Run, replace with the assigned *.run.app URL (or your custom domain).
MCP_ISSUER=http://localhost:3002

# HS256 access-token signing secret (64 random bytes, hex). Rotating this
# invalidates every issued token.
